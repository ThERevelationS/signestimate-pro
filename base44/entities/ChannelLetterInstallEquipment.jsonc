{
  "name": "ChannelLetterInstallEquipment",
  "type": "object",
  "properties": {
    "equipment_name": {
      "type": "string",
      "description": "Name of the equipment"
    },
    "equipment_type": {
      "type": "string",
      "enum": [
        "ladder",
        "scissor_lift",
        "boom_lift",
        "boom_truck",
        "scaffold",
        "truck",
        "car",
        "van",
        "flatbed",
        "hand_tool",
        "power_tool",
        "safety",
        "other"
      ],
      "default": "ladder",
      "description": "Type/category of equipment"
    },
    "ownership": {
      "type": "string",
      "enum": [
        "owned",
        "rented"
      ],
      "default": "rented",
      "description": "Whether the equipment is owned by the shop or rented. Rented equipment is excluded from travel fuel calculations."
    },
    "max_height_feet": {
      "type": "number",
      "default": 0,
      "description": "Maximum working/platform height in feet (for matching install height)"
    },
    "total_boom_height_feet": {
      "type": "number",
      "default": 0,
      "description": "Total boom lift height (platform height + worker reach). Used by the reach chart. Defaults to max_height_feet when blank."
    },
    "horizontal_boom_reach_feet": {
      "type": "number",
      "default": 0,
      "description": "Max horizontal reach of the boom from the pivot point (boom lifts / boom trucks only). Used by the parking-distance reach chart."
    },
    "deployed_truck_width_feet": {
      "type": "number",
      "default": 0,
      "description": "Width of the boom lift carriage / truck when deployed with outriggers. Subtracts from horizontal reach because the boom pivot is centered on the truck."
    },
    "vertical_reach_safety_margin_feet": {
      "type": "number",
      "default": 2,
      "description": "Vertical safety margin to subtract from the boom's stated max height when plotting the reach envelope (accounts for boom angle near vertical and safe operating zone)."
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "owned_flat",
        "per_hour",
        "per_day",
        "per_week",
        "per_month",
        "per_project_flat"
      ],
      "default": "per_day",
      "description": "How this equipment is priced"
    },
    "cost_per_hour": {
      "type": "number",
      "default": 0
    },
    "cost_per_day": {
      "type": "number",
      "default": 0
    },
    "cost_per_week": {
      "type": "number",
      "default": 0
    },
    "cost_per_month": {
      "type": "number",
      "default": 0
    },
    "cost_flat": {
      "type": "number",
      "default": 0,
      "description": "Flat cost (owned equipment day-rate or per-project)"
    },
    "delivery_pickup_cost": {
      "type": "number",
      "default": 0,
      "description": "One-time delivery/pickup fee"
    },
    "mpg": {
      "type": "number",
      "default": 0,
      "description": "Miles per gallon \u2014 only applies to owned vehicles. Used for travel fuel cost calculations."
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "na",
        "gasoline",
        "diesel"
      ],
      "default": "na",
      "description": "Fuel type used by this equipment for travel cost calculations. Only owned vehicles factor into fuel costs."
    },
    "rental_company": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Available for selection"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "equipment_name",
    "equipment_type",
    "pricing_mode"
  ]
}