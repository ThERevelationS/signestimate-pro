{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "material_type": {
      "type": "string",
      "enum": [
        "Aluminum",
        "Steel",
        "Stainless_Steel",
        "Galvanized_Steel",
        "Brass",
        "Copper",
        "Plastic",
        "Other"
      ],
      "description": "Type of material"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "Angle",
        "Channel",
        "Tube_Square",
        "Tube_Round",
        "Flat_Bar",
        "Round_Bar",
        "Sheet",
        "Plate",
        "I_Beam",
        "H_Beam",
        "Pipe",
        "Other"
      ],
      "description": "Type of product/extrusion"
    },
    "size": {
      "type": "string",
      "description": "Dimensions (e.g., 2x2x1/4, 4x8, 1.5 OD)"
    },
    "thickness_gauge": {
      "type": "string",
      "description": "Thickness or gauge (e.g., 1/8, 14ga, 0.125)"
    },
    "standard_length": {
      "type": "number",
      "description": "Standard length in feet"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Cost per unit"
    },
    "unit_type": {
      "type": "string",
      "enum": [
        "per_foot",
        "per_piece",
        "per_pound",
        "per_sqft"
      ],
      "default": "per_foot",
      "description": "Unit pricing type"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier or vendor name"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the material"
    }
  },
  "required": [
    "material_type",
    "product_type",
    "size",
    "cost_per_unit"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}