{
  "name": "DefaultModuleSettings",
  "type": "object",
  "properties": {
    "module_name": {
      "type": "string",
      "enum": [
        "painting",
        "laser",
        "cnc",
        "metal_fabrication",
        "channel_letter_installation",
        "foundation",
        "brick_stone",
        "sign_maintenance"
      ],
      "description": "The unique identifier for the module."
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "The default enabled state for new users."
    }
  },
  "required": [
    "module_name",
    "is_enabled"
  ]
}