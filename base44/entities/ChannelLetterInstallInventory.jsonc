{
  "name": "ChannelLetterInstallInventory",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "flush_mount_hardware",
        "halo_lit_hardware",
        "raceway_material",
        "dimensional_lettering_hardware",
        "electrical",
        "consumable",
        "other"
      ],
      "default": "flush_mount_hardware"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "flush_mount",
        "halo_lit",
        "raceway",
        "dimensional_lettering",
        "all"
      ],
      "default": "all",
      "description": "Legacy single-value field. Use applies_to_list for multi-select."
    },
    "applies_to_list": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "flush_mount",
          "halo_lit",
          "raceway",
          "dimensional_lettering"
        ]
      },
      "description": "Installation types this material applies to. Empty array = applies to all."
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "per_letter_flat",
        "per_letter_by_size",
        "per_raceway_foot",
        "per_project_flat"
      ],
      "default": "per_letter_flat"
    },
    "cost_per_letter": {
      "type": "number",
      "default": 0
    },
    "cost_extra_small": {
      "type": "number",
      "default": 0
    },
    "cost_small": {
      "type": "number",
      "default": 0
    },
    "cost_medium": {
      "type": "number",
      "default": 0
    },
    "cost_large": {
      "type": "number",
      "default": 0
    },
    "cost_extra_large": {
      "type": "number",
      "default": 0
    },
    "cost_extra_extra_large": {
      "type": "number",
      "default": 0
    },
    "cost_per_foot": {
      "type": "number",
      "default": 0
    },
    "cost_flat": {
      "type": "number",
      "default": 0
    },
    "quantity_tiers": {
      "type": "array",
      "description": "Optional volume discount tiers. Applied to the headline cost.",
      "items": {
        "type": "object",
        "properties": {
          "min_qty": {
            "type": "number"
          },
          "max_qty": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          }
        }
      }
    },
    "price_history": {
      "type": "array",
      "description": "Snapshots of past pricing changes.",
      "items": {
        "type": "object",
        "properties": {
          "changed_at": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "pricing_mode": {
            "type": "string"
          },
          "snapshot": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "unit": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "item_name",
    "category",
    "pricing_mode"
  ]
}