{
  "name": "ChannelLetterInstallInventory",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "flush_mount_hardware",
        "halo_lit_hardware",
        "raceway_material",
        "electrical",
        "consumable",
        "other"
      ],
      "default": "flush_mount_hardware"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "flush_mount",
        "halo_lit",
        "raceway",
        "all"
      ],
      "default": "all"
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "per_letter_flat",
        "per_letter_by_size",
        "per_raceway_foot",
        "per_project_flat"
      ],
      "default": "per_letter_flat"
    },
    "cost_per_letter": {
      "type": "number",
      "default": 0
    },
    "cost_small": {
      "type": "number",
      "default": 0,
      "description": "Cost per small letter (12-18 inch)"
    },
    "cost_medium": {
      "type": "number",
      "default": 0,
      "description": "Cost per medium letter (18-30 inch)"
    },
    "cost_large": {
      "type": "number",
      "default": 0,
      "description": "Cost per large letter (30-48 inch)"
    },
    "cost_extra_large": {
      "type": "number",
      "default": 0,
      "description": "Cost per XL letter (48-60 inch)"
    },
    "cost_extra_extra_large": {
      "type": "number",
      "default": 0,
      "description": "Cost per XXL letter (60 inch+)"
    },
    "cost_per_foot": {
      "type": "number",
      "default": 0
    },
    "cost_flat": {
      "type": "number",
      "default": 0
    },
    "unit": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "item_name",
    "category",
    "pricing_mode"
  ]
}