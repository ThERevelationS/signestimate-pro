{
  "name": "ModuleStatus",
  "type": "object",
  "properties": {
    "module_name": {
      "type": "string",
      "enum": [
        "painting",
        "laser",
        "cnc",
        "metal_fabrication",
        "channel_letter_installation",
        "foundation"
      ],
      "description": "The unique identifier for the module."
    },
    "is_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the module is currently active."
    }
  },
  "required": [
    "module_name"
  ]
}