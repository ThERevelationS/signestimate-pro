{
  "name": "LaborServiceInventory",
  "type": "object",
  "description": "Catalog of outsourced services and labor line items: permitting, engineering stamps, design/art fees, freight/delivery, equipment rental services, subcontractor crews, electrical hookup, crane/lift services, etc. These are billed as services rather than physical inventory.",
  "properties": {
    "service_name": {
      "type": "string"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "permitting",
        "engineering",
        "design_art",
        "delivery_freight",
        "subcontractor_labor",
        "electrical_hookup",
        "crane_lift_service",
        "rental_service",
        "inspection",
        "consulting",
        "shop_labor",
        "field_labor",
        "other"
      ],
      "default": "subcontractor_labor"
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "per_hour",
        "per_day",
        "per_job",
        "per_unit",
        "per_sqft",
        "per_mile"
      ],
      "default": "per_hour"
    },
    "default_rate": {
      "type": "number",
      "default": 0,
      "description": "Default unit price for this service."
    },
    "minimum_charge": {
      "type": "number",
      "default": 0
    },
    "typical_duration_hours": {
      "type": "number",
      "default": 0
    },
    "vendor_name": {
      "type": "string"
    },
    "vendor_contact": {
      "type": "string"
    },
    "vendor_phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "show_in_channel_letters": {
      "type": "boolean",
      "default": true
    },
    "show_in_sign_maintenance": {
      "type": "boolean",
      "default": true
    },
    "show_in_foundation": {
      "type": "boolean",
      "default": true
    },
    "show_in_vinyl_estimator": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "service_name",
    "service_category"
  ]
}