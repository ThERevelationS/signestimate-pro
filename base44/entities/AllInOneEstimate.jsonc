{
  "name": "AllInOneEstimate",
  "type": "object",
  "description": "A multifaceted estimate BUILT from sections. Each section is a dedicated sub-estimate created by (and owned by) this estimate in its module's own entity, edited with that module's full estimator. Totals live-sync from the source projects via real-time subscriptions and refresh-on-open. module_key values match components/allInOne/estimatorRegistry.js.",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "estimate_number": {
      "type": "string"
    },
    "hyperlink": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "archived"
      ],
      "default": "draft"
    },
    "line_items": {
      "type": "array",
      "description": "Estimate sections. Totals are refreshed from the source projects whenever the estimate is opened, and in real time while it is open.",
      "items": {
        "type": "object",
        "properties": {
          "module_key": {
            "type": "string",
            "description": "Key from the estimator registry (e.g. 'painting', 'foundation')."
          },
          "project_id": {
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "total_snapshot": {
            "type": "number",
            "default": 0,
            "description": "Last-known total of the sub-estimate."
          },
          "owned": {
            "type": "boolean",
            "default": false,
            "description": "True when this sub-estimate was created BY this All-In-One estimate (a built-in section). Owned sections are deleted together with the section / estimate."
          },
          "linked_date": {
            "type": "string"
          }
        }
      }
    },
    "total_cost": {
      "type": "number",
      "default": 0,
      "description": "Grand total = sum of all section totals."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_name",
    "client_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}