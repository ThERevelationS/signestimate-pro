{
  "name": "DimensionalLetterMaterial",
  "type": "object",
  "properties": {
    "material_name": {
      "type": "string",
      "description": "Friendly name shown in dropdowns (e.g., '1/2\" PVC Sintra White')"
    },
    "material_type": {
      "type": "string",
      "enum": [
        "acrylic",
        "pvc",
        "aluminum_composite",
        "aluminum_solid",
        "wood",
        "mdf",
        "hdu",
        "foam",
        "other"
      ],
      "default": "pvc"
    },
    "thickness_inches": {
      "type": "number",
      "default": 0.5,
      "description": "Sheet thickness in inches"
    },
    "sheet_length_inches": {
      "type": "number",
      "default": 96,
      "description": "Sheet length (e.g., 96 for 4x8)"
    },
    "sheet_width_inches": {
      "type": "number",
      "default": 48,
      "description": "Sheet width (e.g., 48 for 4x8)"
    },
    "cost_per_sheet": {
      "type": "number",
      "default": 0,
      "description": "Cost for one full sheet at the listed dimensions"
    },
    "yield_factor": {
      "type": "number",
      "default": 0.7,
      "description": "Estimated usable yield after nesting waste (0.5 = 50% usable). Used to derate sheet area for cost-per-sqin."
    },
    "color": {
      "type": "string",
      "description": "Stock color, if applicable"
    },
    "supplier": {
      "type": "string"
    },
    "needs_painting": {
      "type": "boolean",
      "default": true,
      "description": "If false, default to skipping paint cost (e.g., already finished)"
    },
    "allow_laser": {
      "type": "boolean",
      "default": true,
      "description": "Whether this material can be cut on the laser. Some materials (e.g., PVC, ACM, certain metals) should NOT be cut on the laser. When false, the cutting method is forced to CNC in the dimensional fab panel."
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "material_name",
    "material_type"
  ]
}