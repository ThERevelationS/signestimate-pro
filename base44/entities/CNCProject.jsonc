{
  "name": "CNCProject",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "archived"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_type": {
            "type": "string",
            "enum": [
              "panel",
              "lettering",
              "3d_carving"
            ],
            "default": "panel"
          },
          "description": {
            "type": "string"
          },
          "material_type": {
            "type": "string",
            "enum": [
              "Acrylic",
              "Wood",
              "MDF",
              "Plywood",
              "PVC",
              "HDPE",
              "Aluminum",
              "Corian"
            ],
            "default": "Wood"
          },
          "material_thickness": {
            "type": "string",
            "description": "e.g., 1/8\", 1/4\", up to 4\""
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "length": {
            "type": "number",
            "default": 0
          },
          "width": {
            "type": "number",
            "default": 0
          },
          "letter_height": {
            "type": "number",
            "default": 0
          },
          "num_letters": {
            "type": "number",
            "default": 0
          },
          "carve_area_sqin": {
            "type": "number",
            "default": 0
          },
          "carve_depth": {
            "type": "number",
            "default": 0
          },
          "total_cut_length_inches": {
            "type": "number",
            "default": 0
          },
          "cut_speed_ipm": {
            "type": "number",
            "default": 50
          },
          "carve_speed_sqipm": {
            "type": "number",
            "default": 10
          },
          "machine_time_hours": {
            "type": "number"
          },
          "setup_time_hours": {
            "type": "number"
          },
          "machine_cost": {
            "type": "number"
          },
          "labor_cost": {
            "type": "number"
          }
        }
      }
    },
    "machine_rate_per_hour": {
      "type": "number",
      "default": 75
    },
    "labor_rate": {
      "type": "number",
      "default": 45
    },
    "setup_time_percentage": {
      "type": "number",
      "default": 20
    },
    "fixed_setup_hours": {
      "type": "number",
      "default": 0,
      "description": "Fixed setup time for the entire project in hours."
    },
    "total_machine_cost": {
      "type": "number"
    },
    "total_labor_cost": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_name",
    "client_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}