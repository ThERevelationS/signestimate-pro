{
  "name": "ChannelLetterInstallation",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "estimate_number": {
      "type": "string"
    },
    "hyperlink": {
      "type": "string"
    },
    "site_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "archived"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "installation_type": {
            "type": "string",
            "enum": [
              "flush_mount",
              "halo_lit",
              "raceway",
              "dimensional_lettering"
            ],
            "default": "flush_mount"
          },
          "qty_letters": {
            "type": "number",
            "default": 0
          },
          "letter_size": {
            "type": "string",
            "enum": [
              "extra_small",
              "small",
              "medium",
              "large",
              "extra_large",
              "extra_extra_large"
            ],
            "default": "medium"
          },
          "letter_height_inches": {
            "type": "number",
            "default": 24
          },
          "installation_height_feet": {
            "type": "number",
            "default": 12
          },
          "raceway_length_feet": {
            "type": "number",
            "default": 0
          },
          "wall_material": {
            "type": "string",
            "default": "eifs"
          },
          "thick_hollow_walls": {
            "type": "boolean",
            "default": false
          },
          "parapet": {
            "type": "boolean",
            "default": false
          },
          "poor_electrical_access": {
            "type": "boolean",
            "default": false
          },
          "poor_electrical_severity": {
            "type": "number",
            "default": 1,
            "description": "Severity level 1-10 for Poor Electrical Access \u2014 drives the additive minutes/letter bonus on top of the base electrical hookup time."
          },
          "escort_required": {
            "type": "boolean",
            "default": false
          },
          "badging_checkin": {
            "type": "boolean",
            "default": false
          },
          "after_hours_weekend": {
            "type": "boolean",
            "default": false
          },
          "set_hours_installation": {
            "type": "boolean",
            "default": false
          },
          "poor_site_access": {
            "type": "boolean",
            "default": false
          },
          "poor_site_access_severity": {
            "type": "number",
            "default": 1,
            "description": "Severity level 1-10 for Poor Site Access \u2014 drives the additive minutes/letter bonus on top of the base install time."
          },
          "source_letter_purchase_id": {
            "type": "string",
            "description": "Auto-generated items reference the letter_purchases row that spawned them"
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "inventory_item_id": {
                  "type": "string"
                },
                "item_name": {
                  "type": "string"
                },
                "pricing_mode": {
                  "type": "string"
                },
                "unit_cost": {
                  "type": "number"
                },
                "quantity": {
                  "type": "number"
                },
                "total_cost": {
                  "type": "number"
                },
                "is_custom": {
                  "type": "boolean"
                },
                "image_url": {
                  "type": "string"
                }
              }
            }
          },
          "labor_hours": {
            "type": "number"
          },
          "labor_cost": {
            "type": "number"
          },
          "materials_cost": {
            "type": "number"
          },
          "item_total_cost": {
            "type": "number"
          }
        }
      }
    },
    "letter_purchases": {
      "type": "array",
      "description": "Channel letter purchase line items (separate from installation labor).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable client-side id used to link to auto-generated install items."
          },
          "letter_type": {
            "type": "string",
            "enum": [
              "raceway",
              "channel_raceway_mounted",
              "channel_flush_mounted",
              "channel_halo_lit",
              "capsule_logo_pillbox",
              "dimensional_letters"
            ],
            "default": "channel_flush_mounted"
          },
          "description": {
            "type": "string"
          },
          "raceway_index": {
            "type": "number",
            "description": "1, 2, 3, or 4 \u2014 which raceway escalation tier to use (per the price sheet).",
            "default": 1
          },
          "qty": {
            "type": "number",
            "default": 0,
            "description": "Number of letters, logos, or raceways"
          },
          "size_value": {
            "type": "number",
            "default": 0,
            "description": "Vertical inches (channel letters), linear feet (raceway), or square feet (capsule/logo/dimensional)"
          },
          "unit_cost": {
            "type": "number",
            "default": 0,
            "description": "Auto-derived from settings unless overridden"
          },
          "unit_cost_override": {
            "type": "boolean",
            "default": false
          },
          "total_cost": {
            "type": "number",
            "default": 0
          },
          "create_install_item": {
            "type": "boolean",
            "default": true,
            "description": "Auto-create a matching line item on the Installation tab"
          },
          "install_height_feet": {
            "type": "number",
            "default": 12
          },
          "wall_material": {
            "type": "string",
            "default": "eifs"
          },
          "fab_config": {
            "type": "object",
            "description": "Dimensional letter fabrication breakdown (material + CNC + paint). Populated by the DimensionalFabModal.",
            "additionalProperties": true
          }
        }
      }
    },
    "letters_delivery_fee": {
      "type": "number",
      "default": 0
    },
    "letters_design_fee": {
      "type": "number",
      "default": 0
    },
    "letters_install_supplies_fee": {
      "type": "number",
      "default": 0
    },
    "letters_permitting_fee": {
      "type": "number",
      "default": 0
    },
    "letters_other_fee": {
      "type": "number",
      "default": 0
    },
    "letters_markup_percent": {
      "type": "number",
      "default": 0,
      "description": "Markup applied to the letter purchase subtotal (does not affect install)."
    },
    "letters_subtotal": {
      "type": "number"
    },
    "total_letters_cost": {
      "type": "number"
    },
    "selected_equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "equipment_id": {
            "type": "string"
          },
          "equipment_name": {
            "type": "string"
          },
          "equipment_type": {
            "type": "string"
          },
          "pricing_mode": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "default": 1
          },
          "include_delivery": {
            "type": "boolean",
            "default": false
          },
          "delivery_pickup_cost": {
            "type": "number",
            "default": 0
          },
          "unit_cost": {
            "type": "number",
            "default": 0
          },
          "total_cost": {
            "type": "number",
            "default": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "personnel": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "hourly_rate": {
            "type": "number",
            "default": 0
          },
          "hours": {
            "type": "number",
            "default": 0
          },
          "total_cost": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "supplies_percent_of_materials": {
      "type": "number",
      "default": 10
    },
    "extra_supplies_cost": {
      "type": "number",
      "default": 0
    },
    "base_supplies_cost": {
      "type": "number",
      "default": 0
    },
    "markup_percent": {
      "type": "number",
      "default": 0
    },
    "labor_hours": {
      "type": "number"
    },
    "labor_cost": {
      "type": "number"
    },
    "total_materials_cost": {
      "type": "number"
    },
    "total_supplies_cost": {
      "type": "number"
    },
    "total_equipment_cost": {
      "type": "number"
    },
    "total_personnel_cost": {
      "type": "number"
    },
    "subtotal": {
      "type": "number"
    },
    "markup_amount": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "installation_type": {
      "type": "string",
      "description": "Legacy"
    },
    "qty_letters": {
      "type": "number",
      "description": "Legacy"
    },
    "letter_size": {
      "type": "string",
      "description": "Legacy"
    },
    "letter_height_inches": {
      "type": "number",
      "description": "Legacy"
    },
    "installation_height_feet": {
      "type": "number",
      "description": "Legacy"
    },
    "raceway_length_feet": {
      "type": "number",
      "description": "Legacy"
    },
    "thick_hollow_walls": {
      "type": "boolean",
      "description": "Legacy"
    },
    "parapet": {
      "type": "boolean",
      "description": "Legacy"
    },
    "poor_electrical_access": {
      "type": "boolean",
      "description": "Legacy"
    }
  },
  "required": [
    "project_name",
    "client_name",
    "estimate_number",
    "hyperlink"
  ]
}