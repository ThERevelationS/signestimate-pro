{
  "name": "ChannelLetterInstallation",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "estimate_number": {
      "type": "string"
    },
    "hyperlink": {
      "type": "string"
    },
    "site_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "calculated",
        "archived"
      ],
      "default": "draft"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "installation_type": {
            "type": "string",
            "enum": [
              "flush_mount",
              "halo_lit",
              "raceway",
              "dimensional_lettering"
            ],
            "default": "flush_mount"
          },
          "qty_letters": {
            "type": "number",
            "default": 0
          },
          "letter_size": {
            "type": "string",
            "enum": [
              "extra_small",
              "small",
              "medium",
              "large",
              "extra_large",
              "extra_extra_large"
            ],
            "default": "medium"
          },
          "letter_height_inches": {
            "type": "number",
            "default": 24
          },
          "installation_height_feet": {
            "type": "number",
            "default": 12
          },
          "raceway_length_feet": {
            "type": "number",
            "default": 0
          },
          "wall_material": {
            "type": "string",
            "default": "eifs"
          },
          "thick_hollow_walls": {
            "type": "boolean",
            "default": false
          },
          "parapet": {
            "type": "boolean",
            "default": false
          },
          "poor_electrical_access": {
            "type": "boolean",
            "default": false
          },
          "escort_required": {
            "type": "boolean",
            "default": false
          },
          "badging_checkin": {
            "type": "boolean",
            "default": false
          },
          "after_hours_weekend": {
            "type": "boolean",
            "default": false
          },
          "set_hours_installation": {
            "type": "boolean",
            "default": false
          },
          "poor_site_access": {
            "type": "boolean",
            "default": false
          },
          "materials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "inventory_item_id": {
                  "type": "string"
                },
                "item_name": {
                  "type": "string"
                },
                "pricing_mode": {
                  "type": "string"
                },
                "unit_cost": {
                  "type": "number"
                },
                "quantity": {
                  "type": "number"
                },
                "total_cost": {
                  "type": "number"
                },
                "is_custom": {
                  "type": "boolean"
                },
                "image_url": {
                  "type": "string"
                }
              }
            }
          },
          "labor_hours": {
            "type": "number"
          },
          "labor_cost": {
            "type": "number"
          },
          "materials_cost": {
            "type": "number"
          },
          "item_total_cost": {
            "type": "number"
          }
        }
      }
    },
    "selected_equipment": {
      "type": "array",
      "description": "Equipment chosen for this installation project.",
      "items": {
        "type": "object",
        "properties": {
          "equipment_id": {
            "type": "string"
          },
          "equipment_name": {
            "type": "string"
          },
          "equipment_type": {
            "type": "string"
          },
          "pricing_mode": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "default": 1,
            "description": "Number of hours/days/weeks/months used (matches pricing_mode unit)"
          },
          "include_delivery": {
            "type": "boolean",
            "default": false
          },
          "delivery_pickup_cost": {
            "type": "number",
            "default": 0
          },
          "unit_cost": {
            "type": "number",
            "default": 0
          },
          "total_cost": {
            "type": "number",
            "default": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "personnel": {
      "type": "array",
      "description": "Crew members assigned to this job.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "e.g. Crew Lead, Installer, Helper"
          },
          "hourly_rate": {
            "type": "number",
            "default": 0
          },
          "hours": {
            "type": "number",
            "default": 0
          },
          "total_cost": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "supplies_percent_of_materials": {
      "type": "number",
      "default": 10
    },
    "extra_supplies_cost": {
      "type": "number",
      "default": 0
    },
    "base_supplies_cost": {
      "type": "number",
      "default": 0
    },
    "markup_percent": {
      "type": "number",
      "default": 0
    },
    "labor_hours": {
      "type": "number"
    },
    "labor_cost": {
      "type": "number"
    },
    "total_materials_cost": {
      "type": "number"
    },
    "total_supplies_cost": {
      "type": "number"
    },
    "total_equipment_cost": {
      "type": "number"
    },
    "total_personnel_cost": {
      "type": "number"
    },
    "subtotal": {
      "type": "number"
    },
    "markup_amount": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "installation_type": {
      "type": "string",
      "description": "Legacy"
    },
    "qty_letters": {
      "type": "number",
      "description": "Legacy"
    },
    "letter_size": {
      "type": "string",
      "description": "Legacy"
    },
    "letter_height_inches": {
      "type": "number",
      "description": "Legacy"
    },
    "installation_height_feet": {
      "type": "number",
      "description": "Legacy"
    },
    "raceway_length_feet": {
      "type": "number",
      "description": "Legacy"
    },
    "thick_hollow_walls": {
      "type": "boolean",
      "description": "Legacy"
    },
    "parapet": {
      "type": "boolean",
      "description": "Legacy"
    },
    "poor_electrical_access": {
      "type": "boolean",
      "description": "Legacy"
    }
  },
  "required": [
    "project_name",
    "client_name",
    "estimate_number",
    "hyperlink"
  ]
}