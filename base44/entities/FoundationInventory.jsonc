{
  "name": "FoundationInventory",
  "type": "object",
  "properties": {
    "material_name": {
      "type": "string",
      "description": "Name of the material or equipment"
    },
    "material_description": {
      "type": "string",
      "description": "Detailed description shown in dropdowns"
    },
    "material_type": {
      "type": "string",
      "enum": [
        "concrete_service",
        "bagged_concrete",
        "rebar",
        "forming_material",
        "excavation_equipment",
        "attachment",
        "sub_attachment",
        "pole",
        "brick_stone",
        "fill_material",
        "wall_material"
      ],
      "description": "Type of material"
    },
    "foundation_usage": {
      "type": "string",
      "enum": [
        "spread_foot",
        "pillar",
        "general"
      ],
      "description": "Specific foundation type this material is used for"
    },
    "lumber_size": {
      "type": "string",
      "enum": [
        "2x4",
        "2x6",
        "2x8",
        "2x10",
        "2x12",
        "plywood_3/4",
        "custom"
      ]
    },
    "thickness_inches": {
      "type": "number"
    },
    "pole_shape": {
      "type": "string",
      "enum": [
        "square",
        "round"
      ]
    },
    "pole_width_inches": {
      "type": "number"
    },
    "pole_depth_inches": {
      "type": "number"
    },
    "pole_wall_thickness_inches": {
      "type": "number"
    },
    "pole_stock_length_ft": {
      "type": "number"
    },
    "pole_stock_price": {
      "type": "number"
    },
    "pole_pricing_mode": {
      "type": "string",
      "enum": [
        "per_foot",
        "stock_price"
      ]
    },
    "paint_rate_per_linear_ft": {
      "type": "number"
    },
    "brick_length_inches": {
      "type": "number"
    },
    "brick_width_inches": {
      "type": "number"
    },
    "brick_height_inches": {
      "type": "number"
    },
    "brick_color": {
      "type": "string"
    },
    "brick_texture": {
      "type": "string",
      "enum": [
        "smooth",
        "rough",
        "textured",
        "glazed"
      ]
    },
    "fill_material_subtype": {
      "type": "string",
      "enum": [
        "cinder_block",
        "poured_concrete",
        "gravel",
        "foam",
        "sand"
      ]
    },
    "wall_material_subtype": {
      "type": "string",
      "enum": [
        "brick",
        "cinderblock",
        "stone",
        "concrete"
      ]
    },
    "wall_unit_length_inches": {
      "type": "number"
    },
    "wall_unit_width_inches": {
      "type": "number"
    },
    "wall_unit_height_inches": {
      "type": "number"
    },
    "wall_color": {
      "type": "string"
    },
    "wall_texture": {
      "type": "string",
      "enum": [
        "smooth",
        "rough",
        "textured",
        "glazed"
      ]
    },
    "equipment_type": {
      "type": "string"
    },
    "compatible_equipment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_attachment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_sub_attachment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parent_attachment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_multiple": {
      "type": "boolean"
    },
    "supplier": {
      "type": "string"
    },
    "rental_company": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "cost_per_unit": {
      "type": "number"
    },
    "minimum_order_yards": {
      "type": "number"
    },
    "below_minimum_cost_per_cy": {
      "type": "number"
    },
    "minimum_cost": {
      "type": "number"
    },
    "cost_per_day": {
      "type": "number"
    },
    "cost_per_week": {
      "type": "number"
    },
    "cost_per_month": {
      "type": "number"
    },
    "pickup_delivery_cost": {
      "type": "number"
    },
    "rebar_size": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_pillar_excavation": {
      "type": "boolean"
    },
    "is_spread_foot_excavation": {
      "type": "boolean"
    },
    "is_non_excavation_equipment": {
      "type": "boolean"
    },
    "is_miscellaneous_attachment": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "number"
    },
    "mix_3500_price": {
      "type": "number"
    },
    "mix_4000_price": {
      "type": "number"
    },
    "mix_4500_price": {
      "type": "number"
    },
    "mix_5000_price": {
      "type": "number"
    },
    "mix_fast_set_price": {
      "type": "number"
    },
    "admix_calcium_chloride_price": {
      "type": "number"
    },
    "admix_set_retarding_price": {
      "type": "number"
    },
    "admix_water_reducing_price": {
      "type": "number"
    },
    "admix_fibers_price": {
      "type": "number"
    },
    "admix_winter_service_price": {
      "type": "number"
    }
  },
  "required": [
    "material_name",
    "material_type"
  ]
}