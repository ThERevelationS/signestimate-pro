{
  "name": "User",
  "type": "object",
  "properties": {
    "screen_name": {
      "type": "string",
      "description": "Editable display name used everywhere the user appears in the app (Salesperson dropdowns, estimates, customer records). Falls back to full_name when empty."
    },
    "is_salesperson": {
      "type": "boolean",
      "default": false,
      "description": "When true this user appears in every Salesperson dropdown (estimates, customers). Managed on the Estimate Settings page."
    },
    "phone": {
      "type": "string",
      "description": "User's phone number"
    },
    "job_title": {
      "type": "string",
      "description": "User's job title or position"
    },
    "department": {
      "type": "string",
      "enum": [
        "Management",
        "Estimating",
        "Production",
        "Sales",
        "Administration"
      ],
      "description": "User's department"
    },
    "bio": {
      "type": "string",
      "description": "Short bio or description"
    },
    "module_permissions": {
      "type": "object",
      "description": "User-specific overrides for module access.",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "enable_ccs_database_lookup": {
      "type": "boolean",
      "default": false,
      "description": "Enable CCS Database Lookup for this user"
    },
    "tutorials_seen": {
      "type": "object",
      "description": "Tracks which tutorials/help tours the user has already seen.",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "tutorials_disabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, tutorial help pop-ups are suppressed globally for this user."
    },
    "auto_save_enabled": {
      "type": "boolean",
      "default": true,
      "description": "User preference for auto-saving projects every 30 seconds"
    }
  },
  "required": []
}